# Identity and secrets. Behaviour — helmet definitions, channel allow/deny, ceremony
# timing, LLM model, log level — lives in config.yaml, which is read-only input the
# bot never writes to.
#
# Copy to .env and populate. .env is gitignored; .env.example is not.

# ── Required ─────────────────────────────────────────────────────────────────

# Discord bot token: Developer Portal → your app → Bot → Reset Token.
# While you are in there, enable both privileged intents under Bot → Privileged
# Gateway Intents: SERVER MEMBERS (to enumerate Eligible Members) and MESSAGE
# CONTENT (to read conversation). The bot cannot work without both.
DISCORD_TOKEN=

# The single Discord server this bot serves. Right-click the server icon with
# Developer Mode on → Copy Server ID.
DISCORD_GUILD_ID=

# ── Optional ─────────────────────────────────────────────────────────────────

# OpenRouter API key: https://openrouter.ai/keys
# The model itself is a config.yaml setting, not a secret.
# Without this the bot still provisions helmets and runs Ceremonies; it just
# speaks in static fallback lines instead of generated ones.
OPENROUTER_API_KEY=

# Single directory holding config.yaml and bot.sqlite. Must be set before config
# is read, which is why it lives here rather than in config.yaml.
# Defaults to ./data locally; the container mounts /data.
PAKLED_DATA_DIR=./data

# Overrides logging.level from config.yaml: debug | info | warn | error.
# Raising the level to watch a live problem is then a restart, not an edit to the
# config file the container mounts. Unset, config.yaml decides.
PAKLED_LOG_LEVEL=

# ── Invite URL ───────────────────────────────────────────────────────────────
# Replace <APPLICATION_ID> with your app's id. Grants exactly the four
# permissions the bot needs: View Channels, Send Messages, Read Message History,
# Manage Roles. Remember to drag the bot's role above the helmet roles afterwards.
#
# https://discord.com/oauth2/authorize?client_id=<APPLICATION_ID>&scope=bot+applications.commands&permissions=268504064
