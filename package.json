    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
