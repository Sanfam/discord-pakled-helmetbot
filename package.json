{
  "name": "discord-pakled-helmetbot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
